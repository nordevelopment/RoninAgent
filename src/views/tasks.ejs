<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RoninAgent - Task Management</title>
    <!-- Use absolute paths starting with slash since static path prefix is '/' -->
    <link href="/css/cybercore.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/chat.css">
    <link rel="stylesheet" href="/css/task.css">
    <script src="/js/theme.js"></script>

</head>

<body class="cyber-theme">

    <body class="cyber-theme">

        <div class="container">
            <!-- Sidebar -->
            <%- include('sidebar.ejs') %>

                <div class="tasks-container">
                    <!-- Back Button -->
                    <a href="/" style="text-decoration: none; display: inline-block; margin-bottom: 20px;">
                        <button class="cyber-btn cyber-btn--cyan">
                            < BACK TO CHAT</button>
                    </a>

                    <!-- Logo Area -->
                    <div class="logo-panel">
                        <div class="logo cyber-glitch" data-text="TASK MANAGER">
                            TASK MANAGER
                        </div>
                    </div>

                    <!-- Header Actions -->
                    <div class="header-actions">
                        <div class="cyber-text-glow" style="font-size: 14px; text-transform: uppercase;">
                            Manage background instructions for the AI
                        </div>
                        <div style="display: flex; gap: 15px; align-items: center;">
                            <button id="btnRunTasks" class="cyber-btn cyber-btn--green">
                                RUN READY TASKS ⚡
                            </button>
                            <button id="btnOpenAddTask" class="cyber-btn">
                                ADD NEW TASK +
                            </button>
                        </div>
                    </div>

                    <!-- Tasks Table -->
                    <div class="cyber-tile"
                        style="padding: 0; overflow: hidden; border: 1px solid var(--cyber-primary);">
                        <table class="task-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">ID</th>
                                    <th>Task Instruction</th>
                                    <th style="width: 150px;">Status</th>
                                    <th style="width: 120px;">Execution</th>
                                    <th style="width: 200px;">Scheduled Run</th>
                                    <th>AI Execution Result</th>
                                    <th style="width: 220px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tasksTableBody">
                                <!-- Will be dynamically populated -->
                                <tr>
                                    <td colspan="7"
                                        style="text-align: center; color: rgba(255,255,255,0.5); padding: 40px;">
                                        SYSTEM INITIALIZING & LOADING TASKS...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Add/Edit Modal -->
                <div id="taskModal" class="modal-backdrop">
                    <div class="modal-content">
                        <div class="sessions-title cyber-text-glow" id="modalTitle"
                            style="font-size: 18px; margin: 0; padding-bottom: 10px; border-bottom: 1px solid rgba(0,255,136,0.3);">
                            CREATE NEW TASK
                        </div>

                        <input type="hidden" id="taskFormId">

                        <div class="form-group">
                            <label for="taskFormTitle">Instruction (What should AI do?)</label>
                            <textarea id="taskFormTitle" class="cyber-textarea" style="height: 100px; resize: none;"
                                placeholder="e.g. Scan directory './src' for any TODO comments and write a report to todo_report.txt"></textarea>
                        </div>

                        <div class="form-group">
                            <label for="taskFormStatus">Status</label>
                            <select id="taskFormStatus" class="cyber-select">
                                <option value="ready">Ready for run</option>
                                <option value="done">Done</option>
                                <option value="running" disabled>Running (system lock)</option>
                                <option value="failed">Failed</option>
                            </select>
                        </div>

                        <div class="form-group"
                            style="flex-direction: row; align-items: center; gap: 10px; margin: 10px 0;">
                            <input type="checkbox" id="taskFormIsAuto"
                                style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--cyber-primary);">
                            <label for="taskFormIsAuto"
                                style="cursor: pointer; user-select: none; margin: 0; text-transform: uppercase; font-size: 12px; color: var(--cyber-secondary);">Auto-execute
                                in background</label>
                        </div>

                        <div class="form-group">
                            <label for="taskFormRunAt">Scheduled Run (Optional)</label>
                            <input type="datetime-local" id="taskFormRunAt" class="cyber-input" style="padding: 8px;">
                            <small style="color: rgba(255,255,255,0.5); font-size: 11px;">If set, task will not execute
                                until this
                                time has arrived.</small>
                        </div>

                        <div class="modal-footer">
                            <button id="btnCancelModal" class="cyber-btn cyber-btn--magenta btn-mini">CANCEL</button>
                            <button id="btnSaveTask" class="cyber-btn btn-mini">SAVE TASK</button>
                        </div>
                    </div>
                </div>

                <!-- View Result Modal -->
                <div id="resultModal" class="modal-backdrop">
                    <div class="modal-content" style="width: 700px; max-width: 95%;">
                        <div class="sessions-title cyber-text-glow"
                            style="font-size: 18px; margin: 0; padding-bottom: 10px; border-bottom: 1px solid rgba(0,255,136,0.3);">
                            AI EXECUTION RESULT
                        </div>

                        <div class="form-group">
                            <label>Task Instruction</label>
                            <div id="resultModalInstruction"
                                style="background: rgba(255,255,255,0.05); padding: 12px; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; max-height: 80px; overflow-y: auto; white-space: pre-wrap;">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Output</label>
                            <div id="resultModalOutput"
                                style="background: rgba(0, 255, 136, 0.03); border: 1px solid var(--cyber-primary); color: #e0e0e0; padding: 15px; border-radius: 4px; max-height: 350px; overflow-y: auto; white-space: pre-wrap; font-size: 13px; line-height: 1.5; box-shadow: inset 0 0 10px rgba(0, 255, 136, 0.05);">
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button id="btnCloseResultModal" class="cyber-btn cyber-btn--cyan btn-mini">CLOSE</button>
                        </div>
                    </div>
                </div>

                <script src="/js/tasks.js"></script>
    </body>

</html>