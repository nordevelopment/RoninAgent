{
  "name": "ronin-agent",
  "version": "2.6.5",
  "description": "RoninAgent — Lightweight, sovereign, zero-bloat open-source personal AI agent",
  "author": "Norayr Petrosyan",
  "license": "MIT",
  "type": "module",
  "main": "dist/backend/server.js",
  "keywords": [
    "ai",
    "agent",
    "personal ai",
    "personal assistant",
    "open source",
    "AI Assistant",
    "Personal AI",
    "Personal Digital Assistant",
    "AI Companion",
    "LLM Personal Assistant",
    "Local AI Assistant",
    "AI Agent Framework",
    "AI Helper",
    "AI Tool",
    "AI Program",
    "AI Software"
  ],
  "scripts": {
    "predev": "node scripts/check-deps.js",
    "prestart": "node scripts/check-deps.js",
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:frontend": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"tsx watch src/backend/server.ts\" \"vite\"",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "build": "tsc && vite build",
    "start": "npm run build && node dist/backend/server.js",
    "db:reset": "tsx src/backend/database/db-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "eventsource-parser": "^3.1.1",
    "exceljs": "^3.4.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^5.1.0",
    "fastify-sse-v2": "^4.2.2",
    "mammoth": "^1.12.1",
    "marked": "^15.0.12",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "puppeteer": "^25.7.0",
    "sharp": "^0.35.3",
    "sqlite-vec": "^0.1.9",
    "telegraf": "^4.16.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
